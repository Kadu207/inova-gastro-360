generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]
  branches  Branch[]
  users     User[]

  @@map("tenants")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  legalName      String?  @map("legal_name")
  tradeName      String   @map("trade_name")
  documentNumber String?  @map("document_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@index([tenantId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  address   String?
  timezone  String   @default("America/Sao_Paulo")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userAccess   UserBranchAccess[]
  categories   ProductCategory[]
  products     Product[]
  orders       Order[]

  @@index([tenantId])
  @@index([companyId])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("atendente")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     Session[]
  branchAccess UserBranchAccess[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([tenantId])
  @@map("user_branch_access")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  idempotencyKey String?   @unique @map("idempotency_key")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, publishedAt])
  @@map("outbox_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  priceCents   Int      @default(0) @map("price_cents")
  interval     String   @default("month")
  maxBranches  Int      @default(1) @map("max_branches")
  maxProducts  Int      @default(50) @map("max_products")
  isActive     Boolean  @default(true) @map("is_active")
  stripePriceId      String? @map("stripe_price_id")
  asaasPlanValueCents Int?   @map("asaas_plan_value_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  checkouts     SubscriptionCheckout[]

  @@map("subscription_plans")
}

model SubscriptionCheckout {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  planId                  String   @map("plan_id") @db.Uuid
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  stripeCustomerId        String?  @map("stripe_customer_id")
  asaasCheckoutId         String?  @unique @map("asaas_checkout_id")
  status                  String   @default("open")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscription_checkouts")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  planId               String?   @map("plan_id") @db.Uuid
  status               String    @default("trialing")
  trialEndsAt          DateTime? @map("trial_ends_at")
  currentPeriodEnd     DateTime? @map("current_period_end")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  asaasSubscriptionId  String?   @unique @map("asaas_subscription_id")
  asaasCustomerId      String?   @map("asaas_customer_id")
  gracePeriodEndsAt    DateTime? @map("grace_period_ends_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  plan SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, branchId])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([tenantId, branchId])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  orderNumber   Int      @map("order_number")
  channel       String   @default("web")
  status        String   @default("pending")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  notes         String?
  totalCents    Int      @default(0) @map("total_cents")
  paymentStatus String   @default("unpaid") @map("payment_status")
  paymentMethod String?  @map("payment_method")
  paidAt        DateTime? @map("paid_at")
  idempotencyKey String? @map("idempotency_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  paymentIntents PaymentIntent[]

  @@unique([tenantId, idempotencyKey])
  @@unique([branchId, orderNumber])
  @@index([tenantId, branchId, status])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int    @default(1)
  unitCents  Int    @map("unit_cents")
  totalCents Int    @map("total_cents")
  notes      String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String
  changedBy String?  @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model PaymentIntent {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  provider          String    @default("asaas")
  method            String
  amountCents       Int       @map("amount_cents")
  currency          String    @default("BRL")
  status            String    @default("created")
  externalId        String?   @map("external_id")
  externalReference String    @map("external_reference")
  pixQrCode         String?   @map("pix_qr_code") @db.Text
  pixCopyPaste      String?   @map("pix_copy_paste") @db.Text
  expiresAt         DateTime? @map("expires_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([externalId])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  result          String?
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, externalEventId])
  @@index([tenantId, createdAt])
  @@map("payment_events")
}

model PrintJob {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  sector    String   @default("cozinha")
  status    String   @default("pending")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, branchId, status])
  @@index([orderId])
  @@map("print_jobs")
}

/// Spec 009 — LGPD: registro de consentimento de cookies (essencial/analytics/marketing).
model ConsentRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Identificador do titular no navegador (cookie/localStorage) — permite consulta sem exigir login.
  subjectId  String   @map("subject_id")
  essential  Boolean  @default(true)
  analytics  Boolean  @default(false)
  marketing  Boolean  @default(false)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, subjectId])
  @@index([tenantId, createdAt])
  @@map("consent_records")
}

/// Spec 009 — LGPD: workflow de "direito ao esquecimento" (solicitação + status + auditoria).
model ErasureRequest {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  requestedBy String?   @map("requested_by") @db.Uuid
  /// E-mail, telefone ou userId do titular alvo da solicitação.
  subjectId   String    @map("subject_id")
  subjectType String    @default("user") @map("subject_type")
  status      String    @default("pending")
  reason      String?
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, subjectId])
  @@map("erasure_requests")
}

model CashSession {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  openedBy     String?   @map("opened_by") @db.Uuid
  closedBy     String?   @map("closed_by") @db.Uuid
  status       String    @default("open")
  openingCents Int       @default(0) @map("opening_cents")
  closingCents Int?      @map("closing_cents")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@index([tenantId, branchId, status])
  @@map("cash_sessions")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  cashSessionId String?  @map("cash_session_id") @db.Uuid
  entryType     String   @map("entry_type")
  amountCents   Int      @map("amount_cents")
  description   String
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, createdAt])
  @@index([cashSessionId])
  @@map("ledger_entries")
}

model Payable {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  description String
  amountCents Int       @map("amount_cents")
  dueDate     DateTime  @map("due_date")
  status      String    @default("open")
  paidAt      DateTime? @map("paid_at")
  supplier    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status, dueDate])
  @@map("payables")
}

model Receivable {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  description String
  amountCents Int       @map("amount_cents")
  dueDate     DateTime  @map("due_date")
  status      String    @default("open")
  paidAt      DateTime? @map("paid_at")
  customer    String?
  orderId     String?   @map("order_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status, dueDate])
  @@index([orderId])
  @@map("receivables")
}
