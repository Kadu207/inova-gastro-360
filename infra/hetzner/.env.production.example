# Copie para infra/hetzner/.env.production na VPS (nunca commitar valores reais)
# spec 013 — T011

# Banco (Postgres na mesma VPS — container inova-gastro-360-postgres :5440)
# Use host.docker.internal para containers Docker; migrate no host usa 127.0.0.1 automaticamente
DATABASE_URL=postgresql://inova_gastro:CHANGE_ME@host.docker.internal:5440/inova_gastro_360?schema=public

JWT_SECRET=change-me-min-32-chars-production

# URLs internas Docker (rede inova_internal)
MESSAGING_URL=http://messaging-bus:8789
REALTIME_URL=http://realtime-hub:8790
INTEGRATIONS_URL=http://integrations:8791
REDIS_URL=redis://redis:6379

# Web (build/start)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8792
NEXT_PUBLIC_REALTIME_URL=http://127.0.0.1:8790
NODE_ENV=production
