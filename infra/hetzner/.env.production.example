# Copie para infra/hetzner/.env.production na VPS (nunca commitar valores reais)
# spec 013 — T011
# Apenas linhas KEY=valor abaixo — sem linhas decorativas ou comentários soltos

DATABASE_URL=postgresql://inova_gastro:CHANGE_ME@host.docker.internal:5440/inova_gastro_360?sslmode=require
DATABASE_SSL_INSECURE=1
JWT_SECRET=change-me-min-32-chars-production
POSTGRES_PASSWORD=CHANGE_ME
MESSAGING_URL=http://messaging-bus:8789
REALTIME_URL=http://realtime-hub:8790
INTEGRATIONS_URL=http://integrations:8791
WEB_HEALTH_URL=http://web:3102/login
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_API_URL=https://inovagastro360.inovatitech.com.br
NEXT_PUBLIC_REALTIME_URL=https://inovagastro360.inovatitech.com.br
NODE_ENV=production

# Object storage — catálogo (spec 014). MinIO inova-platform-core (rede Docker interna).
STORAGE_PROVIDER=minio
# configure-s3-env-vps.sh define endpoint (host.docker.internal OU nome do container MinIO)
S3_ENDPOINT=http://inova-platform-core-minio-1:9000
MINIO_CONTAINER=inova-platform-core-minio-1
S3_REGION=auto
S3_BUCKET=inova-gastro-360
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# MinIO interno — path-style via nginx /media/ (browser não usa cdn.inovatitech até go-live CDN)
S3_PUBLIC_BASE_URL=https://inovagastro360.inovatitech.com.br/media/inova-gastro-360
