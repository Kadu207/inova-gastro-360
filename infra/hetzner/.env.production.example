# Copie para infra/hetzner/.env.production na VPS (nunca commitar valores reais)
# spec 013 — T011
# Apenas linhas KEY=valor abaixo — sem linhas decorativas ou comentários soltos

DATABASE_URL=postgresql://inova_gastro:CHANGE_ME@host.docker.internal:5440/inova_gastro_360?sslmode=require
# Após T053 (inova_gastro_app na API): preserve owner para migrations
MIGRATION_DATABASE_URL=postgresql://inova_gastro:CHANGE_ME@host.docker.internal:5440/inova_gastro_360?sslmode=require
DATABASE_SSL_INSECURE=1
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
OUTBOX_FLUSH_SECRET=CHANGE_ME_openssl_rand_base64_32
INTERNAL_SHARED_SECRET=CHANGE_ME_openssl_rand_base64_32
CORS_ALLOWED_ORIGINS=https://inovagastro360.inovatitech.com.br
SEED_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
MESSAGING_URL=http://messaging-bus:8789
REALTIME_URL=http://realtime-hub:8790
INTEGRATIONS_URL=http://integrations:8791
WEB_HEALTH_URL=http://web:3102/login
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_API_URL=https://inovagastro360.inovatitech.com.br
NEXT_PUBLIC_REALTIME_URL=https://inovagastro360.inovatitech.com.br
NODE_ENV=production

# Object storage — catálogo (spec 014). MinIO inova-platform-core (rede Docker interna).
STORAGE_PROVIDER=minio
# configure-s3-env-vps.sh define endpoint (host.docker.internal OU nome do container MinIO)
S3_ENDPOINT=http://inova-platform-core-minio-1:9000
MINIO_CONTAINER=inova-platform-core-minio-1
MINIO_DOCKER_NETWORK=inova-platform-core_inova-platform
S3_REGION=auto
S3_BUCKET=inova-gastro-360
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# MinIO interno — path-style via nginx /media/ (browser não usa cdn.inovatitech até go-live CDN)
S3_PUBLIC_BASE_URL=https://inovagastro360.inovatitech.com.br/media/inova-gastro-360

# --- Pagamentos spec 007 (Mercado Pago + Stripe) ---
# Modo dormant (pré-venda): PAYMENTS_ENABLED=false + CHANGE_ME — rode prepare-payments-vps.sh
PAYMENTS_ENABLED=false
PAYMENTS_PUBLIC_BASE_URL=https://inovagastro360.inovatitech.com.br
MERCADOPAGO_ACCESS_TOKEN=CHANGE_ME
MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
PAYMENTS_SANDBOX=true
PIX_EXPIRATION_MINUTES=30
STRIPE_PRICE_STARTER=price_CHANGE_ME
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME
# Após venda: configure-payments-env-vps.sh com credenciais reais

