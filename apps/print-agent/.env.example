# Print Agent — Inova Gastro 360 (spec 006)
# Copie para .env na raiz ou exporte antes de npm run print-agent:dev

PRINT_AGENT_API_BASE=http://127.0.0.1:8792
PRINT_AGENT_EMAIL=admin@inovagastro360.local
PRINT_AGENT_PASSWORD=
PRINT_AGENT_TENANT_SLUG=demo-burger
PRINT_AGENT_BRANCH_ID=00000000-0000-4000-8000-000000000002
PRINT_AGENT_SECTOR=cozinha
PRINT_AGENT_POLL_MS=5000
# PRINT_AGENT_DRY_RUN=1

# Impressora ESC/POS (T012)
# PRINTER_TYPE=none       # default — só log + PATCH printed
# PRINTER_TYPE=network    # TCP raw :9100 (Epson/Bematech/etc.)
# PRINTER_HOST=192.168.0.50
# PRINTER_PORT=9100
# PRINTER_TYPE=file       # device Linux ex. /dev/usb/lp0
# PRINTER_DEVICE=/dev/usb/lp0
# PRINTER_TIMEOUT_MS=5000
