{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inova-gastro-360-messaging-bus",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8789
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "services": [
    {
      "binding": "REALTIME_SERVICE",
      "service": "inova-gastro-360-realtime-hub"
    },
    {
      "binding": "INTEGRATIONS_SERVICE",
      "service": "inova-gastro-360-integrations"
    }
  ]
  // Filas Cloudflare (Workers Paid ~US$5/mês) — adiar para fase 2.
  // O handler /internal/publish já encaminha direto para rt + integrations.
  // Ver infra/cloudflare/QUEUES-DEFERRED.md
}
