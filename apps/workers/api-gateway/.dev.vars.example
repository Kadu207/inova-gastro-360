# Criado automaticamente no `npm run dev` (scripts/ensure-dev-vars.mjs)
# Wrangler Hyperdrive local usa localConnectionString em wrangler.jsonc (5440)
DATABASE_URL=postgresql://inova_gastro:inova_gastro_dev@127.0.0.1:5440/inova_gastro_360?schema=public
# Gere segredos fortes (>=32 chars). Ex.: openssl rand -base64 32
JWT_SECRET=dev-only-secret-please-generate-a-strong-value
# Obrigatório para autorizar o replay do outbox
OUTBOX_FLUSH_SECRET=dev-only-outbox-secret-generate-value
# Compartilhado entre workers para autenticar rotas internas
INTERNAL_SHARED_SECRET=dev-only-internal-secret-generate-value
# Origens permitidas em CORS (CSV). Vazio em dev = libera localhost.
CORS_ALLOWED_ORIGINS=
# Pagamentos (spec 017 Asaas oficial BR; Stripe fallback; MP legado)
ASAAS_API_KEY=your-asaas-api-key-min-20-chars
ASAAS_WEBHOOK_TOKEN=your-asaas-webhook-token
ASAAS_SANDBOX=true
ORDER_PAYMENT_PROVIDER=asaas
BILLING_PROVIDER=asaas
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PAYMENTS_SANDBOX=true
PIX_EXPIRATION_MINUTES=30
PAYMENTS_ENABLED=true
