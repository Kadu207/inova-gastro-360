{
  "name": "@inova-gastro-360/api-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "test -f .dev.vars || cp .dev.vars.example .dev.vars",
    "dev": "wrangler dev --port 8792 --inspector-port 9230 --local",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@inova-gastro-360/auth": "*",
    "postgres": "3.4.7",
    "zod": "3.25.51"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250613.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wrangler": "4.20.0"
  }
}
