{
  "name": "@inova-gastro-360/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3102 --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "next build",
    "deploy:pages": "wrangler pages deploy out --project-name=inova-gastro-360-web",
    "deploy:web": "wrangler deploy",
    "start": "serve out -l tcp://127.0.0.1:3102 --no-clipboard",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inova-gastro-360/config": "*",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wrangler": "4.20.0"
  }
}
