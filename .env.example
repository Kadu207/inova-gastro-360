# Inova Gastro 360 — Variáveis de ambiente (copiar para .env)

# Portas — ver PORT_REGISTRY.md
WEB_PORT=3102
POSTGRES_PORT=5440
REDIS_PORT=6390
N8N_PORT=5680
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Inova Gastro 360
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3102
NEXT_PUBLIC_API_URL=http://127.0.0.1:8792

# Database (local Docker)
DATABASE_URL=postgresql://inova_gastro:inova_gastro_dev@127.0.0.1:5440/inova_gastro_360?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6390

# Cloudflare (preencher no deploy)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Segurança
JWT_SECRET=change-me-in-production-min-32-chars
